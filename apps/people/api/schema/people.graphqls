scalar Time

type User {
  id: ID!
  organizationId: ID!
  roleId: ID!
  email: String!
  firstName: String!
  lastName: String!
  createdAt: Time!
}

input CreateOrganizationInput {
  name: String!
  ownerEmail: String!
  ownerFirstName: String!
  ownerLastName: String!
}

type CreateOrganizationPayload {
  organizationId: ID!
  owner: User!
}

type Query {
  user(id: ID!): User
}

type Mutation {
  createOrganization(input: CreateOrganizationInput!): CreateOrganizationPayload!
}
