scalar Time

type User {
  id: ID!
  organizationId: ID!
  roleId: ID!
  email: String!
  firstName: String!
  lastName: String!
  createdAt: Time!
}

input CreateOrganizationInput {
  name: String!
  ownerEmail: String!
  ownerFirstName: String!
  ownerLastName: String!
}

type CreateOrganizationPayload {
  organizationId: ID!
  owner: User!
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

type UserConnection {
  nodes: [User!]!
  pageInfo: PageInfo!
}

type Query {
  user(id: ID!): User
  users(organizationId: ID!, first: Int, after: String): UserConnection!
}

type Mutation {
  createOrganization(input: CreateOrganizationInput!): CreateOrganizationPayload!
}
